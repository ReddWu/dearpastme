# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenAI-compatible). Defaults below point at OpenRouter.
# Drop in any OpenAI-compatible provider by changing all three values:
#   OpenAI:     ZAI_BASE_URL=https://api.openai.com/v1        ZAI_MODEL=gpt-4.1
#   DeepSeek:   ZAI_BASE_URL=https://api.deepseek.com/v1      ZAI_MODEL=deepseek-chat
#   Z.AI:       ZAI_BASE_URL=https://api.z.ai/api/paas/v4     ZAI_MODEL=glm-4.6
ZAI_API_KEY=
ZAI_BASE_URL=https://openrouter.ai/api/v1
# Heavier model used for the three branch generations.
ZAI_MODEL=deepseek/deepseek-chat-v3.1
# Lighter, faster model used only for structured profile parsing.
# Optional — defaults to ZAI_MODEL when unset.
ZAI_PARSE_MODEL=deepseek/deepseek-v4-flash

# Replicate (used for both image generation and voice cloning via XTTS-v2)
REPLICATE_API_TOKEN=
